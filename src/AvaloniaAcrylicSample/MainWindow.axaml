<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:acrylic="clr-namespace:JuffMa.Controls.Acrylic;assembly=JuffMa.Controls.Acrylic"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="600" MinHeight="400"
        Width="750" Height="500"
        x:Class="AvaloniaAcrylicSample.MainWindow"
        Title="AvaloniaAcrylic Sample App"
        Icon="Assets/Icon.png">
    <Panel>
        <Image Source="Assets/Background.jpg" Stretch="UniformToFill"/>
        <Grid>
            <Grid.RowDefinitions>50, 70, *, *, 50</Grid.RowDefinitions>
            <Grid.ColumnDefinitions>50, *, *, *, *, 50</Grid.ColumnDefinitions>
            <Panel Grid.Row="1"
                   Grid.Column="1"
                   Grid.ColumnSpan="4"
                   Margin="25 10 25 0">
                <acrylic:AcrylicBackdropControl
                    CornerRadius="100">
                    <acrylic:AcrylicBackdropControl.Material>
                        <ExperimentalAcrylicMaterial 
                            TintColor="Purple"
                            TintOpacity="0.75"
                            MaterialOpacity="0.2"/>
                    </acrylic:AcrylicBackdropControl.Material>
                    <acrylic:AcrylicBackdropControl.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                          Color="Black"
                                          Opacity="0.3"
                                          OffsetX="3"
                                          OffsetY="5"/>
                    </acrylic:AcrylicBackdropControl.Effect>
                </acrylic:AcrylicBackdropControl>
                <TextBlock Padding="5"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           Opacity="0.75">
                    Acrylic Sample
                </TextBlock>
            </Panel>
            <acrylic:AcrylicBackdropControl 
                Margin="25 40 0 0"
                CornerRadius="8 0 0 0"
                Grid.Row="2"
                Grid.Column="1">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="White"
                        TintOpacity="0.2"
                        MaterialOpacity="0.1"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>
            <acrylic:AcrylicBackdropControl 
                Margin="25 0 0 40" 
                CornerRadius="0 0 0 8"
                Grid.Row="3"
                Grid.Column="1">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="White"
                        TintOpacity="0.2"
                        MaterialOpacity="0.8"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>

            <acrylic:AcrylicBackdropControl 
                Margin="0 40 25 0" 
                CornerRadius="0 8 0 0"
                Grid.Row="2"
                Grid.Column="2">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="White"
                        TintOpacity="0.7"
                        MaterialOpacity="0.1"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>
            <acrylic:AcrylicBackdropControl 
                Margin="0 0 25 40" 
                CornerRadius="0 0 8 0"
                Grid.Row="3"
                Grid.Column="2">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="White"
                        TintOpacity="0.9"
                        MaterialOpacity="0.8"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>

            <acrylic:AcrylicBackdropControl 
                Margin="25 40 0 0" 
                CornerRadius="8 0 0 0"
                Grid.Row="2"
                Grid.Column="3">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="Black"
                        TintOpacity="0.2"
                        MaterialOpacity="0.1"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>
            <acrylic:AcrylicBackdropControl 
                Margin="25 0 0 40" 
                CornerRadius="0 0 0 8"
                Grid.Row="3"
                Grid.Column="3">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="Black"
                        TintOpacity="0.2"
                        MaterialOpacity="0.8"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>

            <acrylic:AcrylicBackdropControl 
                Margin="0 40 25 0" 
                CornerRadius="0 8 0 0"
                Grid.Row="2"
                Grid.Column="4">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="Black"
                        TintOpacity="0.7"
                        MaterialOpacity="0.1"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>
            <acrylic:AcrylicBackdropControl 
                Margin="0 0 25 40" 
                CornerRadius="0 0 8 0"
                Grid.Row="3"
                Grid.Column="4">
                <acrylic:AcrylicBackdropControl.Material>
                    <ExperimentalAcrylicMaterial 
                        TintColor="Black"
                        TintOpacity="0.9"
                        MaterialOpacity="0.8"/>
                </acrylic:AcrylicBackdropControl.Material>
            </acrylic:AcrylicBackdropControl>
        </Grid>
    </Panel>
</Window>
